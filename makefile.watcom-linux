# TookOne - MS-DOS (DOS/4G) build of the portable code, OpenWatcom wmake.
#
#   wmake -f makefile.watcom-linux build
#
# Builds what BMPIO can reuse (deps, core, ui and microui) into took.lib,
# plus every STANDALONE test as a DOS executable. The SDL platform backend
# and the desktop app are not built here.

CC      = wcc386
CFLAGS  = -za -w4 -zq -bt=dos -4r -s -otexan
OUT     = build/dos
TFLAGS  = $(CFLAGS) -dSTANDALONE

ENDIAN  = $(OUT)/endian.obj
MICROUI = $(OUT)/microui.obj
IMAGE   = $(OUT)/img_base.obj $(OUT)/img_bmp.obj
RASTER  = $(OUT)/ras_base.obj $(OUT)/ras_blit.obj
UI      = $(OUT)/ui_rend.obj $(OUT)/ui_font.obj $(OUT)/ui_fdata.obj
OBJS    = $(OUT)/bsf.obj $(ENDIAN) $(IMAGE) $(RASTER) $(UI) $(MICROUI)

TESTS   = $(OUT)/t_endian.exe $(OUT)/t_bsf.exe $(OUT)/t_imgbas.exe &
          $(OUT)/t_imgbmp.exe $(OUT)/t_rasbas.exe $(OUT)/t_rasbli.exe &
          $(OUT)/t_uifont.exe $(OUT)/t_uirend.exe

build: $(OUT) $(OUT)/took.lib $(TESTS) .SYMBOLIC

$(OUT): .SYMBOLIC
	mkdir -p $(OUT)

$(OUT)/took.lib: $(OBJS)
	wlib -q -n -b $@ $(OBJS)

# ---- library objects ----

$(OUT)/bsf.obj: deps/bsf/bsf.c deps/bsf/bsf.h
	$(CC) $(CFLAGS) -fo=$@ deps/bsf/bsf.c

$(OUT)/endian.obj: deps/endian/endian.c deps/endian/endian.h
	$(CC) $(CFLAGS) -fo=$@ deps/endian/endian.c

$(OUT)/img_base.obj: core/image/img_base.c core/image/image.h
	$(CC) $(CFLAGS) -fo=$@ core/image/img_base.c

$(OUT)/img_bmp.obj: core/image/img_bmp.c core/image/private.h
	$(CC) $(CFLAGS) -fo=$@ core/image/img_bmp.c

$(OUT)/ras_base.obj: core/raster/ras_base.c core/raster/private.h
	$(CC) $(CFLAGS) -fo=$@ core/raster/ras_base.c

$(OUT)/ras_blit.obj: core/raster/ras_blit.c core/raster/private.h
	$(CC) $(CFLAGS) -fo=$@ core/raster/ras_blit.c

$(OUT)/ui_rend.obj: ui/ui_rend.c ui/private.h
	$(CC) $(CFLAGS) -fo=$@ ui/ui_rend.c

$(OUT)/ui_font.obj: ui/ui_font.c ui/private.h
	$(CC) $(CFLAGS) -fo=$@ ui/ui_font.c

$(OUT)/ui_fdata.obj: ui/ui_fdata.c ui/private.h
	$(CC) $(CFLAGS) -fo=$@ ui/ui_fdata.c

$(OUT)/microui.obj: external/microui/microui.c
	$(CC) $(CFLAGS) -fo=$@ external/microui/microui.c

# ---- STANDALONE tests (each linked against took.lib) ----

$(OUT)/t_endian.obj: deps/endian/endian.c
	$(CC) $(TFLAGS) -fo=$@ deps/endian/endian.c

$(OUT)/t_bsf.obj: deps/bsf/bsf.c
	$(CC) $(TFLAGS) -fo=$@ deps/bsf/bsf.c

$(OUT)/t_imgbas.obj: core/image/img_base.c
	$(CC) $(TFLAGS) -fo=$@ core/image/img_base.c

$(OUT)/t_imgbmp.obj: core/image/img_bmp.c
	$(CC) $(TFLAGS) -fo=$@ core/image/img_bmp.c

$(OUT)/t_rasbas.obj: core/raster/ras_base.c
	$(CC) $(TFLAGS) -fo=$@ core/raster/ras_base.c

$(OUT)/t_rasbli.obj: core/raster/ras_blit.c
	$(CC) $(TFLAGS) -fo=$@ core/raster/ras_blit.c

$(OUT)/t_uifont.obj: ui/ui_font.c
	$(CC) $(TFLAGS) -fo=$@ ui/ui_font.c

$(OUT)/t_uirend.obj: ui/ui_rend.c
	$(CC) $(TFLAGS) -fo=$@ ui/ui_rend.c

$(OUT)/t_endian.exe: $(OUT)/t_endian.obj $(OUT)/took.lib
	wlink system dos4g name $@ option quiet &
		file $(OUT)/t_endian.obj library $(OUT)/took.lib

$(OUT)/t_bsf.exe: $(OUT)/t_bsf.obj $(OUT)/took.lib
	wlink system dos4g name $@ option quiet &
		file $(OUT)/t_bsf.obj library $(OUT)/took.lib

$(OUT)/t_imgbas.exe: $(OUT)/t_imgbas.obj $(OUT)/took.lib
	wlink system dos4g name $@ option quiet &
		file $(OUT)/t_imgbas.obj library $(OUT)/took.lib

$(OUT)/t_imgbmp.exe: $(OUT)/t_imgbmp.obj $(OUT)/took.lib
	wlink system dos4g name $@ option quiet &
		file $(OUT)/t_imgbmp.obj library $(OUT)/took.lib

$(OUT)/t_rasbas.exe: $(OUT)/t_rasbas.obj $(OUT)/took.lib
	wlink system dos4g name $@ option quiet &
		file $(OUT)/t_rasbas.obj library $(OUT)/took.lib

$(OUT)/t_rasbli.exe: $(OUT)/t_rasbli.obj $(OUT)/took.lib
	wlink system dos4g name $@ option quiet &
		file $(OUT)/t_rasbli.obj library $(OUT)/took.lib

$(OUT)/t_uifont.exe: $(OUT)/t_uifont.obj $(OUT)/took.lib
	wlink system dos4g name $@ option quiet &
		file $(OUT)/t_uifont.obj library $(OUT)/took.lib

$(OUT)/t_uirend.exe: $(OUT)/t_uirend.obj $(OUT)/took.lib
	wlink system dos4g name $@ option quiet &
		file $(OUT)/t_uirend.obj library $(OUT)/took.lib

clean: .SYMBOLIC
	rm -rf $(OUT)
